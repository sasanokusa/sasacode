{
  "name": "sasa-code-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sasacode": "bun packages/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun scripts/build.ts",
    "loc": "cat packages/{ai,agent,plugin-api,tools}/src/*.ts | wc -l"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
