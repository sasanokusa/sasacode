{
  "name": "sasa-code-harness",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sasacode": "bun --no-env-file --config=scripts/no-bunfig.toml packages/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun scripts/build.ts",
    "pack:plugin-api": "bun scripts/pack-plugin-api.ts",
    "improve": "bun scripts/improve.ts",
    "pack:plugins": "bun scripts/pack-plugins.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "@earendil-works/pi-tui@0.87.1": "patches/@earendil-works%2Fpi-tui@0.87.1.patch"
  }
}
