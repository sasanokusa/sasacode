{
  "name": "sasa-code-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sasacode": "bun --no-env-file --config=/dev/null packages/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun scripts/build.ts",
    "pack:plugin-api": "bun scripts/pack-plugin-api.ts",
    "loc": "cat packages/{ai,agent,plugin-api,tools}/src/*.ts | wc -l"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "@earendil-works/pi-tui@0.87.1": "patches/@earendil-works%2Fpi-tui@0.87.1.patch"
  }
}
