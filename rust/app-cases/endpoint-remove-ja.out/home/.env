# sasacode の API キー。使うプロバイダーだけ埋める。空欄は無視する。
# どのディレクトリからでも起動のたびに読む。プロジェクトの ./.env は読まない。
# エージェントが実行するコマンド（bash・バックグラウンドジョブ）には渡らない。

# Anthropic （例 -m anthropic/claude-opus-5）
ANTHROPIC_API_KEY=

# OpenAI （例 -m openai/gpt-5.5）
OPENAI_API_KEY=

# OpenRouter （例 -m openrouter/openrouter/auto）
OPENROUTER_API_KEY=

# Command Code （例 -m commandcode/deepseek/deepseek-v4-flash）
CMD_API_KEY=

# Ollama（ollama/<model>）はローカルで動き、キーが要らない。
